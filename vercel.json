{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "echo \"No install step required\"",
  "functions": {
    "api/index.py": {
      "maxDuration": 60,
      "excludeFiles": "{.git/**,.github/**,.vercel/**,.ssh/**,node_modules/**,__pycache__/**,api/__pycache__/**,reports/**,*.sqlite,*.sqlite-*,*.log,handoff.md,destinations*.csv}"
    }
  },
  "rewrites": [
    {
      "source": "/",
      "destination": "/api/index.py"
    },
    {
      "source": "/index.html",
      "destination": "/api/index.py"
    },
    {
      "source": "/sentrynode",
      "destination": "/api/index.py"
    },
    {
      "source": "/sentrynode.html",
      "destination": "/api/index.py"
    },
    {
      "source": "/top-wallets",
      "destination": "/api/index.py"
    },
    {
      "source": "/top-wallets.html",
      "destination": "/api/index.py"
    },
    {
      "source": "/top-wallets.json",
      "destination": "/api/index.py"
    },
    {
      "source": "/emissions",
      "destination": "/api/index.py"
    },
    {
      "source": "/emissions.html",
      "destination": "/api/index.py"
    },
    {
      "source": "/emissions.json",
      "destination": "/api/index.py"
    },
    {
      "source": "/miners",
      "destination": "/api/index.py"
    },
    {
      "source": "/miners.html",
      "destination": "/api/index.py"
    },
    {
      "source": "/miners.json",
      "destination": "/api/index.py"
    },
    {
      "source": "/sn-comp",
      "destination": "/api/index.py"
    },
    {
      "source": "/sn-comp.html",
      "destination": "/api/index.py"
    },
    {
      "source": "/assets/chart.umd.js",
      "destination": "/api/index.py"
    },
    {
      "source": "/masternodes",
      "destination": "/api/index.py"
    },
    {
      "source": "/masternodes.html",
      "destination": "/api/index.py"
    },
    {
      "source": "/sysWalletTracker-vps.tgz",
      "destination": "/api/index.py"
    }
  ]
}
